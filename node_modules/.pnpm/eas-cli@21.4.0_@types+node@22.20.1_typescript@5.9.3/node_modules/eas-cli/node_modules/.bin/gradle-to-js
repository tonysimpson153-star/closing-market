#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/ubuntu/closing-market/node_modules/.pnpm/gradle-to-js@2.0.1/node_modules/gradle-to-js/node_modules:/home/ubuntu/closing-market/node_modules/.pnpm/gradle-to-js@2.0.1/node_modules:/home/ubuntu/closing-market/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/ubuntu/closing-market/node_modules/.pnpm/gradle-to-js@2.0.1/node_modules/gradle-to-js/node_modules:/home/ubuntu/closing-market/node_modules/.pnpm/gradle-to-js@2.0.1/node_modules:/home/ubuntu/closing-market/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../gradle-to-js@2.0.1/node_modules/gradle-to-js/cli.js" "$@"
else
  exec node  "$basedir/../../../../../gradle-to-js@2.0.1/node_modules/gradle-to-js/cli.js" "$@"
fi
