# ─── 서버 ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── 인증 ───────────────────────────────────────────────
# openssl rand -hex 32 로 생성한 강력한 랜덤 값을 넣으세요. 절대 이 예시값을 그대로 쓰지 마세요.
JWT_SECRET=

# ─── 데이터베이스 (TiDB Cloud Starter - MySQL 호환, 무료) ───
# TiDB Cloud 대시보드 > Connect 에서 발급받은 연결 문자열
# 예: mysql://<prefix>.<user>:<password>@<host>:4000/<database>
DATABASE_URL=
# TiDB Cloud는 TLS 접속이 필수이므로 반드시 true로 설정
DB_SSL=true

# ─── 이미지 업로드 (Cloudflare R2 - 무료 10GB) ───────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=closing-market-uploads
# R2 버킷의 공개 접근 URL (r2.dev 주소 또는 연결한 커스텀 도메인)
R2_PUBLIC_URL=

# ─── 카카오 로그인 ───────────────────────────────────────
# 기존에 쓰던 값 그대로 유지
OAUTH_SERVER_URL=

# ─── 비밀번호 찾기 이메일 발송 (Resend) ───────────────────
# resend.com 가입 후 발급받은 API 키
RESEND_API_KEY=
# 도메인 인증 전에는 onboarding@resend.dev 로만 발송 가능(테스트용, 수신자 제한 있음)
# 실제 서비스에서는 Resend에 본인 도메인을 인증하고 예: no-reply@closingmarket.com 사용 권장
RESEND_FROM_EMAIL=onboarding@resend.dev
# 비밀번호 재설정 링크가 가리킬 웹 배포 주소 (Vercel/Netlify 등에 배포한 주소)
WEB_APP_URL=

# ─── 푸시 알림 (선택) ─────────────────────────────────────
EAS_PROJECT_ID=

# ─── 프론트엔드 (앱 빌드 시점에 필요) ─────────────────────
# Render에 배포한 실제 백엔드 주소로 설정 (예: https://closing-market-api.onrender.com)
EXPO_PUBLIC_API_BASE_URL=
